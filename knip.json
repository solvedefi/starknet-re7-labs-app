{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,template,default,not-found,error,global-error,loading,route,sitemap,robots,opengraph-image,icon,apple-icon,manifest}.{ts,tsx,js,jsx,mdx}",
    "generateChangelog.js"
  ],
  "project": ["src/**/*.{ts,tsx}", "*.{js,mjs}"],
  "ignore": ["src/components/ui/**", "src/lib/utils.ts"],
  "ignoreDependencies": [
    "sharp",
    "class-variance-authority",
    "clsx",
    "tailwind-merge",
    "lucide-react",
    "@radix-ui/*"
  ]
}
